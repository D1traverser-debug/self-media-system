{
  "schema_version": 1,
  "studio_version": "1.0.0",
  "product_name": "Video Production Studio",
  "owner": "VIDEO_GROWTH_AGENT",
  "default_entrypoint": "STUDIO_ENTRY.md",
  "cli": "vga-studio",
  "runtime": "video_studio.engine.StudioEngine",
  "state_store": "SQLite_WAL_PER_PROJECT",
  "event_history": "APPEND_ONLY_SQLITE_EVENTS",
  "task_model": "PROJECT_SPECIFIC_DYNAMIC_DAG",
  "execution": {
    "atomic_claims": true,
    "lease_recovery": true,
    "bounded_retries": true,
    "parallel_ready_tasks": true,
    "fixed_stage_machine": false,
    "peer_chat_authority": false
  },
  "artifact_model": {
    "immutable_versions": true,
    "sha256_required": true,
    "project_workspace_only": true,
    "rights_and_provenance": true,
    "downstream_invalidation": true
  },
  "governance": {
    "system": "CAOS",
    "mode": "CHAT_GOVERNED_EXTERNAL",
    "session_governance_required": true,
    "standalone_mode": "OFFLINE_MECHANICAL_TESTS_ONLY",
    "caos_runtime_dependency": false,
    "caos_api_dependency": false,
    "caos_skill_dependency": false,
    "parent_task_or_lease_dependency": false,
    "source_mutation": "FORBIDDEN",
    "domain_authority": "VIDEO_GROWTH_AGENT",
    "session_scope": "ALL_VIDEO_CONVERSATION_DECISIONS_AND_ACTIONS",
    "source_repository": "D1traverser-debug/cognition-agent-os",
    "skill": "cognition-parent-chatgpt-intake",
    "activation_assurance": "NATIVE_TRIGGER_NOT_PROVEN_BY_LOCAL_RUNTIME"
  },
  "decision_method": [
    "COMPETING_HYPOTHESES",
    "DISCRIMINATING_TESTS",
    "ALTERNATIVE_COMPARISON",
    "COUNTEREVIDENCE",
    "FALSIFIER",
    "ROLLBACK"
  ],
  "failure_method": [
    "OBSERVED_SYMPTOM",
    "ROOT_CAUSE_HYPOTHESES",
    "METHOD_CHALLENGE",
    "REPAIR_PLAN",
    "INDEPENDENT_VERIFICATION",
    "REGRESSION_REPLAY"
  ],
  "learning_policy": {
    "default_status": "CANDIDATE",
    "requires_evidence": true,
    "requires_counterexamples": true,
    "requires_failure_conditions": true,
    "requires_independent_replay_for_validation": true
  },
  "ip_authority": {
    "original_identity_canon": "IPOS",
    "video_studio_may_mutate_canon": false
  },
  "media_qa_adapter": "video_studio.media.run_claimed_media_qa",
  "capabilities": {
    "deterministic_media_qa": {
      "tools": [
        "ffprobe",
        "ffmpeg"
      ],
      "checks": [
        "video_stream",
        "stream_duration_match",
        "true_peak",
        "black_frames",
        "full_decode",
        "brief_specific_duration_resolution_frame_rate"
      ],
      "digest_bound": true,
      "fail_closed": true,
      "scope": "technical_measurement_only",
      "auto_release": false
    },
    "release_gates": {
      "artifact_lineage": "IMMUTABLE_INPUT_ARTIFACT_ID_AND_SHA256",
      "source_replacement": "INVALIDATE_CONSUMERS_AND_DEPENDENT_DESCENDANTS",
      "rights": "FINAL_AND_USED_MEDIA_ASSETS_REQUIRE_ALLOWED_STATUS_AND_RESOLVABLE_EVIDENCE",
      "human_review": "EXACT_DIGEST_AND_SELF_ATTESTED_HUMAN_COLD_READ",
      "red_team": "MINIMUM_THREE_EVIDENCE_BACKED_FINDINGS",
      "no_auto_publish": true
    },
    "domain_adapters": {
      "editorial_plan_validate": "video_growth_agent.editorial_planning.EditorialPlan",
      "shot_contract_materialize": "video_growth_agent.editorial_planning.materialize_shot_contract",
      "shot_contract_validate": "video_growth_agent.production_os.ShotContract",
      "ipos_bundle_inspect": "video_growth_agent.ip_identity.inspect_ipos_bundle",
      "ipos_bundle_import": "video_growth_agent.ip_identity.import_ipos_bundle",
      "timeline_validate": "video_growth_agent.timeline.TimelineSpec",
      "continuity_assess": "video_growth_agent.continuity.assess_continuity",
      "shot_route": "video_growth_agent.model_registry.EvidenceBoundModelRouter",
      "business_outcome_metrics": "video_growth_agent.business_metrics.EpisodeOutcomeReceipt",
      "extended_media_qa": "video_growth_agent.media_qa.MediaQAChecker",
      "programmatic_graphic_render": "video_growth_agent.programmatic_graphics.render_programmatic_graphic",
      "media_graph_initialize": "video_growth_agent.media_graph.MediaGraph",
      "ipos_shot_bind": "video_growth_agent.ip_identity.bind_ipos_identity_to_shot",
      "ipos_continuity_snapshot": "video_growth_agent.ip_identity.build_ipos_continuity_snapshot",
      "ipos_continuity_link": "video_growth_agent.ip_identity.build_ipos_continuity_link",
      "business_object_validate": "video_studio.adapters.business_object_from_dict",
      "episode_intent_validate": "video_studio.adapters.program_episode_handoff_to_intent"
    },
    "domain_adapter_execution": {
      "entrypoint": "vga-studio run-adapter",
      "task_bound_inputs": true,
      "immutable_output_registration": true,
      "candidate_promotion_authorized": false,
      "external_provider_generation": "NOT_CONNECTED__REQUIRES_CURRENT_SESSION_CAPABILITY_HANDSHAKE"
    },
    "repository_system_audit": {
      "entrypoint": "vga-studio system-audit",
      "checks": [
        "caos_parent_governance_and_runtime_boundary",
        "runtime_dependency_boundary",
        "domain_adapter_registry_matches_manifest",
        "program_authority_refs_are_digest_bound_inputs",
        "example_graphs_and_default_program_execution",
        "hard_release_gates"
      ],
      "separates_structural_integrity_from_production_readiness": true,
      "no_provider_calls_or_workspace_mutation": true
    }
  },
  "release_status": "ACTIVE_CANDIDATE",
  "business_workstreams": {
    "MEDIA_GROWTH": [
      "audience_research",
      "portfolio_strategy",
      "series_hypotheses",
      "platform_packaging",
      "distribution",
      "audience_outcomes"
    ],
    "ORIGINAL_DIGITAL_IP": [
      "approved_ip_usage",
      "recognition_evidence",
      "performance_evidence",
      "licensing_use_value"
    ],
    "COMMERCIALIZATION": [
      "sponsor_fit",
      "offer_design",
      "deliverable_obligations",
      "product_truth",
      "rights_scope",
      "commercial_measurement"
    ],
    "PRODUCTION_SYSTEM": [
      "editorial_research",
      "story_shot_design",
      "media_generation",
      "editing",
      "sound",
      "quality_review",
      "release"
    ]
  },
  "domain_adapter_policy": {
    "control_plane": "video_studio",
    "video_domain_modules": "VIDEO_OWNED_DOMAIN_LOGIC__EXPLICIT_ADAPTERS_ONLY",
    "fixed_stage_orchestrator": "NOT_LOADED_BY_STUDIO_RUNTIME",
    "require_artifact_receipts": true
  },
  "system_audit": "video_studio.system_audit.run_system_audit",
  "task_admission": {
    "default_project_id": null,
    "default_task_graph": null,
    "automatic_resume": false,
    "route": "video_studio.scope.resolve_intake",
    "project_selection": "EXACT_OWNER_SELECTED_WORKSPACE_ID_ONLY",
    "repository_projects": "RETIRED_EVIDENCE_ONLY",
    "examples": "REGRESSION_FIXTURES_ONLY"
  },
  "architecture": {
    "authority": "docs/standalone_video_studio.md",
    "layers": [
      {
        "id": "L0",
        "owner": "USER",
        "responsibility": "Full outcome, constraints, authorizations and corrections"
      },
      {
        "id": "L1",
        "owner": "CAOS_READ_ONLY",
        "responsibility": "Recursive decision and execution governance, research, challenge, independent overall acceptance"
      },
      {
        "id": "L2",
        "owner": "VIDEO_STUDIO",
        "responsibility": "Domain intent, quality direction, professional capabilities and cross-workstream orchestration"
      },
      {
        "id": "L3",
        "owner": "VIDEO_STUDIO",
        "responsibility": "Per-demand project, deliverable decomposition, dynamic dependency graph and task contracts"
      },
      {
        "id": "L4",
        "owner": "STUDIO_ENGINE",
        "responsibility": "Claims, leases, dependencies, versioned inputs, worker and adapter dispatch"
      },
      {
        "id": "L5",
        "owner": "EXECUTORS",
        "responsibility": "Actual research, creative work, media operations and evidence"
      },
      {
        "id": "L6",
        "owner": "VIDEO_STUDIO_AND_CAOS_DISTINCT_AUTHORITIES",
        "responsibility": "Domain result validation and independent owner outcome verification"
      }
    ],
    "orthogonal_axes": {
      "business_domains": [
        "MEDIA_GROWTH",
        "ORIGINAL_DIGITAL_IP",
        "COMMERCIALIZATION",
        "PRODUCTION_SYSTEM"
      ],
      "media_object_hierarchy": [
        "Program",
        "Series",
        "Episode",
        "Sequence",
        "Scene",
        "Shot",
        "Take"
      ],
      "execution_graph": "Per-demand DAG; not media containment or organization hierarchy",
      "feedback": "Outcome-triggered revisions and new graph generations; no fixed loop or mandatory stage ordering"
    },
    "continuous_responsibilities": {
      "owner_goal_fidelity": "ALL_DECISIONS_AND_ACTIONS",
      "caos_governance": "ALL_DECISIONS_AND_ACTIONS",
      "professional_aesthetic_judgment": "ALL_RELEVANT_CREATIVE_DECISIONS_AND_REVISIONS",
      "audience_and_communication_value": "ALL_RELEVANT_EDITORIAL_AND_PACKAGING_DECISIONS",
      "truth_rights_authorization": "ALL_APPLICABLE_EFFECTS",
      "source_version_context_isolation": "ALL_RETRIEVAL_AND_HANDOFFS",
      "quality_and_independent_acceptance": "ALL_DELIVERABLES",
      "learning_and_failure_reentry": "WHEN_EVIDENCE_CHANGES_OR_METHOD_FAILS"
    },
    "method_selection": "Contextual capabilities, not mandatory task nodes; each applies at relevant decision/effect boundary."
  },
  "knowledge_lifecycle": {
    "index": "video_studio/data/knowledge_catalog.json",
    "active_statuses": [
      "ACTIVE_REFERENCE",
      "VERIFIED_OPERATION"
    ],
    "candidate_status": "CANDIDATE_REQUIRES_REVALIDATION",
    "retired_status": "RETIRED_EVIDENCE_ONLY",
    "rules": [
      "Exact source/version before use",
      "No historical project facts as new-task constraints",
      "Source changes invalidate dependent claims",
      "Promotion requires scoped independent replay",
      "Retirement removes active authority, not provenance",
      "No physical delete without authority and reference checks"
    ]
  }
}
