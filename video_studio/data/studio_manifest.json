{
  "schema_version": 1,
  "studio_version": "1.0.0",
  "product_name": "Video Production Studio",
  "owner": "VIDEO_GROWTH_AGENT",
  "default_entrypoint": "STUDIO_ENTRY.md",
  "cli": "vga-studio",
  "runtime": "video_studio.engine.StudioEngine",
  "state_store": "SQLite_WAL_PER_PROJECT",
  "event_history": "APPEND_ONLY_SQLITE_EVENTS",
  "task_model": "PROJECT_SPECIFIC_DYNAMIC_DAG",
  "execution": {
    "atomic_claims": true,
    "lease_recovery": true,
    "bounded_retries": true,
    "parallel_ready_tasks": true,
    "fixed_stage_machine": false,
    "peer_chat_authority": false
  },
  "artifact_model": {
    "immutable_versions": true,
    "sha256_required": true,
    "project_workspace_only": true,
    "rights_and_provenance": true,
    "downstream_invalidation": true
  },
  "governance": {
    "system": "VIDEO_STUDIO_NATIVE",
    "mode": "STANDALONE",
    "caos_runtime_dependency": false,
    "caos_api_dependency": false,
    "caos_skill_dependency": false,
    "parent_task_or_lease_dependency": false,
    "governance_method_owned_by_video": false,
    "caos_session_governance_supported": true,
    "caos_source_repository": "D1traverser-debug/cognition-agent-os",
    "caos_source_mutation": "FORBIDDEN",
    "caos_session_governance_when_active": true,
    "video_domain_method_owned_by_video": true,
    "parent_governance_owned_externally": true
  },
  "decision_method": [
    "COMPETING_HYPOTHESES",
    "DISCRIMINATING_TESTS",
    "ALTERNATIVE_COMPARISON",
    "COUNTEREVIDENCE",
    "FALSIFIER",
    "ROLLBACK"
  ],
  "failure_method": [
    "OBSERVED_SYMPTOM",
    "ROOT_CAUSE_HYPOTHESES",
    "METHOD_CHALLENGE",
    "REPAIR_PLAN",
    "INDEPENDENT_VERIFICATION",
    "REGRESSION_REPLAY"
  ],
  "learning_policy": {
    "default_status": "CANDIDATE",
    "requires_evidence": true,
    "requires_counterexamples": true,
    "requires_failure_conditions": true,
    "requires_independent_replay_for_validation": true
  },
  "legacy_compatibility": {
    "vga_cli": "video_growth_agent.cli:main",
    "baseline": "0.8.0",
    "authority": "COMPATIBILITY_ONLY_FOR_NEW_STUDIO_PROJECTS"
  },
  "ip_authority": {
    "original_identity_canon": "IPOS",
    "video_studio_may_mutate_canon": false
  },
  "media_qa_adapter": "video_studio.media.run_claimed_media_qa",
  "capabilities": {
    "deterministic_media_qa": {
      "tool": "ffprobe",
      "scope": "technical_measurement_only",
      "digest_bound": true,
      "auto_release": false
    },
    "image_set_concept_contract": {
      "module": "video_studio.image_set",
      "assurance": "HARNESS_WIRED",
      "scope": "concept_and_prompt_diversity_only",
      "image_generation_connected": false,
      "pixel_level_visual_diversity_proven": false
    },
    "video_generation": {
      "assurance": "DECLARED_ONLY",
      "persistent_provider_executor_registered": false,
      "session_tools_must_be_checked_per_run": true
    },
    "local_scene_rendering": {
      "assurance": "DECLARED_ONLY",
      "general_character_or_cinematic_renderer_registered": false
    },
    "technical_media_qa": {
      "assurance": "HARNESS_WIRED",
      "tool": "ffprobe",
      "scope": "technical_measurement_only",
      "auto_release": false
    },
    "media_job_contract": {
      "module": "video_studio.job_contract",
      "assurance": "HARNESS_WIRED",
      "typed_deliverables": true,
      "legacy_filename_deliverables_supported": true,
      "implicit_paid_actions": false,
      "automatic_publication": false,
      "stable_artifact_name_mapping": true,
      "task_completion_checks_declared_deliverable_outputs": true,
      "release_checks_all_required_deliverables": true,
      "checks_real_bytes_and_media_type": true,
      "rights_status_checked_for_each_required_deliverable": true,
      "qualitative_review_remains_separate": true
    }
  },
  "release_status": "REBUILD_IN_PROGRESS",
  "business_workstreams": {
    "MEDIA_GROWTH": [
      "audience_research",
      "portfolio_strategy",
      "series_hypotheses",
      "platform_packaging",
      "distribution",
      "audience_outcomes"
    ],
    "ORIGINAL_DIGITAL_IP": [
      "approved_ip_usage",
      "recognition_evidence",
      "performance_evidence",
      "licensing_use_value"
    ],
    "COMMERCIALIZATION": [
      "sponsor_fit",
      "offer_design",
      "deliverable_obligations",
      "product_truth",
      "rights_scope",
      "commercial_measurement"
    ],
    "PRODUCTION_SYSTEM": [
      "editorial_research",
      "story_shot_design",
      "media_generation",
      "editing",
      "sound",
      "quality_review",
      "release"
    ]
  },
  "domain_adapter_policy": {
    "control_plane": "video_studio",
    "legacy_specialized_modules": "OPTIONAL_VERIFIED_ADAPTERS",
    "legacy_fixed_stage_orchestrator": "NOT_A_CONTROLLER",
    "require_artifact_receipts": true
  },
  "product_scope": "PRODUCTION_FIRST_WITH_OPTIONAL_MEDIA_GROWTH_IP_AND_COMMERCIALIZATION",
  "business_workstreams_optional": true
}
